# 复制为 .env 后按需修改。docker compose 与后端共用这一份配置。
# 注意：DB_PASSWORD 必须与 MYSQL_ROOT_PASSWORD 一致（本项目后端使用 root 连接）。

# MySQL
MYSQL_ROOT_PASSWORD=campus123456
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USERNAME=root
DB_PASSWORD=campus123456

# Redis
REDIS_PASSWORD=campus123456
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# Nacos
NACOS_SERVER_ADDR=127.0.0.1:8848

# RocketMQ
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# ShardingSphere 5.3.2 的 YAML 由驱动直接读取，不支持环境变量占位符。
# 如需修改数据库密码，请同步修改：
#   backend/campus-user/src/main/resources/shardingsphere-config.yaml
#   backend/campus-service/src/main/resources/shardingsphere-config.yaml
